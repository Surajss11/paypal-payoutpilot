# Copy to .env (gitignored). PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox
# Payouts needs the app's sandbox business account to be in a Payouts country (for example US).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live; PAYPAL_ENV is accepted too. Live also needs PAYOUTPILOT_ALLOW_LIVE=1
PAYPAL_ENVIRONMENT=sandbox
# Sandbox personal account email, used as the receiver by scripts/sandbox_evidence.py
PAYPAL_SANDBOX_PERSONAL=
# Run fully offline with PAYPAL_MODE=mock
# PAYPAL_MODE=mock

# LLM: empty = auto (GEMINI_API_KEY, then GROQ_API_KEY, else the offline deterministic judge)
# Or set gemini | groq | ollama | mock, or LLM_BASE_URL + LLM_MODEL for any OpenAI-compatible API
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# Guardrails (defaults shown)
# PAYOUTPILOT_MAX_ITEM=1000
# PAYOUTPILOT_MAX_BATCH=5000
