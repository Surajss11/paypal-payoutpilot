# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_MODE=mock   # run fully offline

# LLM: gemini | groq | ollama | mock  (or set LLM_BASE_URL + LLM_MODEL for any OpenAI-compatible API)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash
